              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', function () { pm.response.to.have.status(401); });",
                  "pm.test('El cuerpo trae statusCode y message', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.statusCode).to.eql(401);",
                  "  pm.expect(body).to.have.property('message');",
                  "});",
                  "pm.test('El error no filtra trazas ni SQL', function () {",
