{
  "info": {
    "_postman_id": "8093627b-afea-4a7f-b752-7f24d3add120",
    "name": "TaskFlow - Integrante 1 - Auth",
    "description": "Auth del Integrante 1: registro, login (USER y ADMIN), logout y escenarios negativos (409, 400, 401, 403). Usar el environment compartido. Orden: Auth completo y, al final, Session. Ver postman/README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register USER",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman User\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Crea una cuenta con rol USER. El script crea un correo distinto para cada ejecución y guarda userId."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('userEmail', `postman-${Date.now()}@example.com`);",
                  "pm.environment.set('userPassword', 'TaskflowPostman123!');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "  const user = pm.response.json();",
                  "  pm.environment.set('userId', user.id);",
                  "  pm.test('Registration returns a USER id', function () {",
                  "    pm.expect(user.role).to.eql('USER');",
                  "    pm.expect(user).not.to.have.property('passwordHash');",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Login (USER or ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "tokenTarget=user guarda accessToken; tokenTarget=admin guarda adminToken. Para ADMIN, define adminEmail/adminPassword con una cuenta ADMIN existente."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const target = pm.environment.get('tokenTarget') || 'user';",
                  "const isAdmin = target === 'admin';",
                  "pm.variables.set('loginEmail', pm.environment.get(isAdmin ? 'adminEmail' : 'userEmail'));",
                  "pm.variables.set('loginPassword', pm.environment.get(isAdmin ? 'adminPassword' : 'userPassword'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const result = pm.response.json();",
                  "  const target = pm.environment.get('tokenTarget') || 'user';",
                  "  pm.environment.set(target === 'admin' ? 'adminToken' : 'accessToken', result.accessToken);",
                  "  pm.test('Login returns a Bearer access token', function () {",
                  "    pm.expect(result.accessToken).to.be.a('string').and.not.empty;",
                  "    pm.expect(result.tokenType).to.eql('Bearer');",
                  "  });",
                  "}",
                  "pm.test('expiresIn es positivo', function () { if (pm.response.code === 200) pm.expect(pm.response.json().expiresIn).to.be.above(0); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Login ADMIN (seed)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Inicia sesión con la cuenta ADMIN del seed (adminEmail=admin@taskflow.com y adminPassword=SEED_ADMIN_PASSWORD, cargados solo en el environment local) y guarda adminToken sin cambiar tokenTarget."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const result = pm.response.json();",
                  "  pm.environment.set('adminToken', result.accessToken);",
                  "  pm.test('Login ADMIN devuelve un token Bearer', function () {",
                  "    pm.expect(result.accessToken).to.be.a('string').and.not.empty;",
                  "    pm.expect(result.tokenType).to.eql('Bearer');",
                  "    pm.expect(result.expiresIn).to.be.above(0);",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Escenarios negativos",
          "description": "Ejecutar después de Register USER y Login. Todas las peticiones esperan un error; la expectativa es el código específico.",
          "item": [
            {
              "name": "[409] Register con correo duplicado",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/api/auth/register",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Duplicado\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "description": "Reutiliza el userEmail creado por Register USER."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('HTTP 409', function () { pm.response.to.have.status(409); });",
                      "pm.test('El cuerpo trae statusCode y message', function () {",
                      "  const body = pm.response.json();",
                      "  pm.expect(body.statusCode).to.eql(409);",
                      "  pm.expect(body).to.have.property('message');",
                      "  pm.expect(body.message).to.include('registrado');",
                      "});",
                      "pm.test('El error no filtra trazas ni SQL', function () {",
                      "  const text = pm.response.text();",
                      "  pm.expect(text).not.to.include('stack');",
                      "  pm.expect(text).not.to.match(/SELECT|INSERT|QueryFailed/i);",
                      "});"
                    ]
                  }
                }
              ],
              "response": []
            },
