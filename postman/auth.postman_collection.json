    {
      "name": "Session",
      "item": [
        {
          "name": "Logout",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/logout",
            "description": "Debe ejecutarse al final: revoca el accessToken actual incrementando tokenVersion. Antes de limpiarlo, guarda una copia en revokedToken para comprobar que ya no sirve."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 204', function () { pm.response.to.have.status(204); });",
                  "if (pm.response.code === 204) {",
                  "  pm.environment.set('revokedToken', pm.environment.get('accessToken'));",
                  "  pm.environment.unset('accessToken');",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
