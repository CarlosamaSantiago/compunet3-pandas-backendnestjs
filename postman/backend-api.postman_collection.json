{
  "info": {
    "_postman_id": "4a903570-8b1e-4dad-92a9-1bfeb19869d8",
    "name": "Backend API",
    "description": "TaskFlow API requests for Auth, Users, Tasks, and Health. Register/login first; ADMIN requests require an existing ADMIN account.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('HTTP response is successful', function () {",
          "  pm.expect(pm.response.code).to.be.within(200, 299);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register USER",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman User\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Crea una cuenta con rol USER. El script crea un correo distinto para cada ejecución y guarda userId."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('userEmail', `postman-${Date.now()}@example.com`);",
                  "pm.environment.set('userPassword', 'TaskflowPostman123!');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const user = pm.response.json();",
                  "  pm.environment.set('userId', user.id);",
                  "  pm.test('Registration returns a USER id', function () {",
                  "    pm.expect(user.role).to.eql('USER');",
                  "    pm.expect(user).not.to.have.property('passwordHash');",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Login (USER or ADMIN)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "tokenTarget=user guarda accessToken; tokenTarget=admin guarda adminToken. Para ADMIN, define adminEmail/adminPassword con una cuenta ADMIN existente."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const target = pm.environment.get('tokenTarget') || 'user';",
                  "const isAdmin = target === 'admin';",
                  "pm.variables.set('loginEmail', pm.environment.get(isAdmin ? 'adminEmail' : 'userEmail'));",
                  "pm.variables.set('loginPassword', pm.environment.get(isAdmin ? 'adminPassword' : 'userPassword'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const result = pm.response.json();",
                  "  const target = pm.environment.get('tokenTarget') || 'user';",
                  "  pm.environment.set(target === 'admin' ? 'adminToken' : 'accessToken', result.accessToken);",
                  "  pm.test('Login returns a Bearer access token', function () {",
                  "    pm.expect(result.accessToken).to.be.a('string').and.not.empty;",
                  "    pm.expect(result.tokenType).to.eql('Bearer');",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get my profile",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{accessToken}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/me",
            "description": "Consulta el perfil de la cuenta autenticada. Guarda su ID en userId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const user = pm.response.json();",
                  "  pm.environment.set('userId', user.id);",
                  "  pm.test('Profile omits sensitive fields', function () {",
                  "    pm.expect(user).not.to.have.property('passwordHash');",
                  "    pm.expect(user).not.to.have.property('tokenVersion');",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Update my profile",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{accessToken}}", "type": "string" }
              ]
            },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman User Updated\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/users/me",
            "description": "Actualiza solo campos del perfil permitidos: name y/o email."
          },
          "response": []
        },
        {
          "name": "List users (ADMIN)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{adminToken}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users?page=1&limit=10",
            "description": "Requiere adminToken de una cuenta que ya tenga rol ADMIN."
          },
          "response": []
        },
        {
          "name": "Change user role (ADMIN)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{adminToken}}", "type": "string" }
              ]
            },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"ADMIN\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/users/{{userId}}/role",
            "description": "Promueve el usuario de userId. Protege al último ADMIN."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Create task",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{accessToken}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Preparar entrega TaskFlow\",\n  \"description\": \"Revisar requisitos\",\n  \"status\": \"PENDING\",\n  \"priority\": \"MEDIUM\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/tasks",
            "description": "Crea una tarea para el usuario autenticado y guarda su id en taskId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.environment.set('taskId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "List my tasks",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{accessToken}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tasks?page=1&limit=10&status=PENDING&priority=MEDIUM"
          },
          "response": []
        },
        {
          "name": "Get my task",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{accessToken}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tasks/{{taskId}}"
          },
          "response": []
        },
        {
          "name": "Update my task",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{accessToken}}", "type": "string" }
              ]
            },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\",\n  \"priority\": \"HIGH\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/tasks/{{taskId}}"
          },
          "response": []
        },
        {
          "name": "Delete my task",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{accessToken}}", "type": "string" }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/tasks/{{taskId}}",
            "description": "Elimina la tarea creada por Create task; devuelve HTTP 204."
          },
          "response": []
        },
        {
          "name": "List all tasks (ADMIN)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{adminToken}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/admin/tasks?page=1&limit=10",
            "description": "Requiere adminToken de una cuenta con rol ADMIN."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Session",
      "item": [
        {
          "name": "Logout",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{accessToken}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/logout",
            "description": "Debe ejecutarse al final: revoca el accessToken actual incrementando tokenVersion."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 204) {",
                  "  pm.environment.unset('accessToken');",
                  "}"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    }
  ]
}
